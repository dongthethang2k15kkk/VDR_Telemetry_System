# ── VDR deploy config — chép file này thành .env rồi điền ──
# cp .env.example .env

# Nơi server ghi DB lịch sử (trong container). Mount ra volume ở compose.
SERVER_DB_PATH=/data/server_history.db

# MQTT broker (tên service "mqtt" trong cùng mạng docker-compose)
MQTT_HOST=mqtt
MQTT_PORT=9001
MQTT_WS_PATH=/mqtt
MQTT_TLS=0
MQTT_TOPIC_PREFIX=vdr

# Tài khoản MQTT (sinh file passwd bằng lệnh trong README, trước khi compose up)
MQTT_USER=vdr
MQTT_PASS=DOI_MAT_KHAU_NAY

# Firebase push (server). Mount file thật vào đường dẫn này.
# Thiếu file -> server bỏ qua push, KHÔNG crash.
FIREBASE_KEY_PATH=/secrets/firebase_key.json

# Domain đặt trước nginx/Cloudflare (chỉ để tham khảo, nginx dùng)
# VDR_DOMAIN=vdr.bkauto.vn
# Mật khẩu đăng nhập web (bắt buộc đổi — không dùng mặc định trong code)
LAB_PASSWORD=DOI_MAT_KHAU_WEB

# Noi luu phien dang nhap (session token). BAT BUOC nam trong /data (volume da
# mount) - de trong hoac sai duong dan se lam session mat khi container bi
# tao lai (docker compose down && up, hoac --build).
DATABASE_PATH=/data/auth_sessions.db
