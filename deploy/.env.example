# ── VDR deploy config — copy file nay thanh .env roi dien ──
# cp .env.example .env

# Noi server ghi DB lich su (trong container). Mount ra volume o compose.
SERVER_DB_PATH=/data/server_history.db

# MQTT broker (ten service "mqtt" trong cung mang docker-compose)
MQTT_HOST=mqtt
MQTT_PORT=9001
MQTT_WS_PATH=/mqtt
MQTT_TLS=0
MQTT_TOPIC_PREFIX=vdr

# Firebase push (server). Mount file that vao duong dan nay.
# Thieu file -> server bo qua push, KHONG crash.
FIREBASE_KEY_PATH=/secrets/firebase_key.json

# Domain dat truoc nginx/Cloudflare (chi de tham khao, nginx xai)
# VDR_DOMAIN=vdr.bkauto.vn